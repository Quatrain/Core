{
   "extends": "@tsconfig/recommended/tsconfig.json",
   "compileOnSave": true,
   "compilerOptions": {
      "rootDir": "src",
      "outDir": "dist",
      "declaration": true,
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "resolveJsonModule": true,
      "strict": true,
      "types": ["node", "jest"],
      "lib": ["ES2022"]
   },
   "include": ["src"],
   "exclude": ["node_modules", "dist", "**/__test__", "**/*.spec.ts", "**/*.test.ts"]
}
